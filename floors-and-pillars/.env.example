# Public base URL, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Brief delivery: console (default) | webhook | email | file
#   console – logs the brief to the server console (development)
#   webhook – POSTs the brief as JSON to BRIEF_WEBHOOK_URL
#   email   – stub; see lib/brief/deliver.ts to connect a provider
#   file    – appends to data/briefs.json (self-hosted/dev only; lets /desk open briefs)
BRIEF_DELIVERY=console
BRIEF_WEBHOOK_URL=
# Optional shared secret sent as the X-Brief-Signature header (HMAC-SHA256 of the body).
BRIEF_WEBHOOK_SECRET=

# Advisor desk (/desk). When unset in production, /desk returns 404.
DESK_PASSCODE=

# Set to "production" to make `npm run content:check` fail on any placeholder.
LAUNCH_MODE=
